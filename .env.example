# Casa Madre — environment template. Copy to `.env.local` and fill in.

# SMTP for the contact-form notification email (/api/contact).
# Port 587 = STARTTLS (the default); 465 switches to implicit TLS automatically.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Where contact-form enquiries are delivered.
CONTACT_TO=

# Canonical base URL for all canonical / OG / sitemap / robots URLs.
NEXT_PUBLIC_SITE_URL=

# WhatsApp is digits only, international format without "+" (e.g. 34123456789).
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Legal data
CLIENT_LEGAL_NAME=
CLIENT_CONTACT_PHONE=
CLIENT_CONTACT_EMAIL=
CLIENT_TAX_ID=
CLIENT_AICAT=
CLIENT_NPIFF=

# Sanity project (public IDs are safe to expose; the read token is server-only).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=

# Anthropic API key — server-only, powers the AI journal-draft route.
ANTHROPIC_API_KEY=

# Cloudinary — hosts the Journal interview videos (Cloudinary transcodes on
# upload; Sanity does not). Only the cloud name is needed: the Studio uploads
# through the UNSIGNED preset "casamadre_journal", so no API key or secret ever
# reaches the browser and editors don't need their own Cloudinary accounts.
# Safe to expose — it appears in every delivery URL. NEXT_PUBLIC_* vars are
# inlined at build time, so redeploy (or restart `next dev`) after changing it.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Holding / "coming soon" page toggle. When "true", every public route shows the
# on-brand coming-soon page; /studio and /api stay reachable so the CMS and the
# contact form keep working. Default "false" (the real site is shown).
# NOTE: NEXT_PUBLIC_* vars are inlined at build time — after changing this,
# rebuild (or restart `next dev`) for it to take effect.
NEXT_PUBLIC_COMING_SOON=false
