# Casa Madre — environment template. Copy to `.env.local` and fill in.
# Never commit real secrets; `.env.local` is gitignored.

# Resend transactional email (contact form). Get a key at https://resend.com
RESEND_API_KEY=

# Public contact channels (safe to expose to the client bundle).
# WhatsApp is digits only, international format without "+" (e.g. 34676496919).
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Canonical base URL for all canonical / OG / sitemap / robots URLs.
# No trailing slash (e.g. https://casamadre.es).
NEXT_PUBLIC_SITE_URL=

# Sanity project (public IDs are safe to expose; the read token is server-only).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=

# Anthropic API key — server-only, powers the AI journal-draft route.
ANTHROPIC_API_KEY=
